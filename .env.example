# Keep this file as a template. Never commit real secrets.
# Create a secret key in your Runway developer account and store it only on the backend.
RUNWAY_API_KEY=
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_MODEL=gen4.5
RUNWAY_VERSION=2024-11-06
ALLOWED_ORIGINS=http://localhost:5173

# Frontend only: set this to the deployed backend origin when frontend/backend are hosted separately.
# Leave blank when /api is routed to the backend on the same origin.
VITE_API_BASE_URL=
